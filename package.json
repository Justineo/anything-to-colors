{
  "name": "anything-to-colors",
  "private": true,
  "description": "Turn any imagination into a flowing color palette.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "check": "vue-tsc --noEmit && vp check",
